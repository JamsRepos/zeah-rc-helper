<?xml version="1.0"?>
<!--
 Style rules copied from runelite/runelite (config/checkstyle/checkstyle.xml,
 BSD-2, Copyright (c) 2017 Adam <Adam@sigterm.info>) plus the Plugin Hub
 forbidden-API checks at the bottom. See AGENTS.md.
-->
<!DOCTYPE module PUBLIC
		"-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
		"https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
	<property name="charset" value="UTF-8"/>
	<property name="fileExtensions" value="java"/>

	<module name="TreeWalker">
		<!-- RuneLite code conventions: Allman braces, tabs, no trailing whitespace -->
		<module name="LeftCurly">
			<property name="option" value="nl"/>
		</module>
		<module name="RightCurly">
			<property name="option" value="alone"/>
		</module>
		<module name="NeedBraces"/>
		<module name="RegexpSinglelineJava">
			<property name="format" value="^\t* "/>
			<property name="message" value="Indent must use tab characters"/>
			<property name="ignoreComments" value="true"/>
		</module>
		<module name="RegexpSinglelineJava">
			<property name="format" value="[^\s]\s+$"/>
			<property name="message" value="No trailing whitespace"/>
			<property name="ignoreComments" value="true"/>
		</module>
		<module name="RegexpSinglelineJava">
			<property name="format" value="^\s+$"/>
			<property name="message" value="Empty lines should not be indented"/>
			<property name="ignoreComments" value="true"/>
		</module>
		<module name="WhitespaceAround"/>
		<module name="WhitespaceAfter">
			<property name="tokens" value="COMMA"/>
		</module>
		<module name="UnusedImports"/>
		<module name="AvoidStarImport">
			<property name="allowStaticMemberImports" value="true"/>
		</module>

		<!-- Plugin Hub forbidden APIs (AGENTS.md) -->
		<module name="IllegalImport">
			<property name="illegalPkgs" value="java.lang.reflect, java.net.http, sun, com.sun, org.apache.http"/>
			<property name="illegalClasses" value="java.awt.Desktop, java.net.HttpURLConnection, java.lang.ProcessBuilder, java.util.concurrent.CountDownLatch, java.io.ObjectInputStream, java.io.ObjectOutputStream"/>
		</module>
		<module name="RegexpSinglelineJava">
			<property name="format" value="Thread\.sleep\("/>
			<property name="message" value="Thread.sleep is forbidden; schedule work instead"/>
			<property name="ignoreComments" value="true"/>
		</module>
		<module name="RegexpSinglelineJava">
			<property name="format" value="Runtime\.getRuntime\(\)\.exec\(|new ProcessBuilder\("/>
			<property name="message" value="Executing external processes is forbidden in hub plugins"/>
			<property name="ignoreComments" value="true"/>
		</module>
		<module name="RegexpSinglelineJava">
			<property name="format" value="awaitTermination\("/>
			<property name="message" value="Never block on executor shutdown; use shutdownNow()"/>
			<property name="ignoreComments" value="true"/>
		</module>
		<module name="RegexpSinglelineJava">
			<property name="format" value="\.getClass\(\)\.get(Declared)?(Method|Field|Constructor)s?\(|Class\.forName\("/>
			<property name="message" value="Reflection is forbidden in hub plugins"/>
			<property name="ignoreComments" value="true"/>
		</module>

		<module name="SuppressionCommentFilter"/>
	</module>

	<module name="RegexpMultiline">
		<property name="format" value="else[ \t]*[\r\n]+[ \t]*if"/>
		<property name="message" value="Newline should not be between else and if"/>
	</module>
	<module name="NewlineAtEndOfFile">
		<property name="lineSeparator" value="lf"/>
	</module>
</module>
